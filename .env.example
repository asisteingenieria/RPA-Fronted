# API de administración del robot (apps/api de RobotRPA). En desarrollo Vite reenvía /admin aquí,
# así el panel y la API comparten origen y la cookie de sesión funciona. Por defecto http://localhost:3000.
ADMIN_API_URL=

# URL que los equipos robot usan para llegar a la pasarela (/robot-api/v1). Se muestra en
# "Instalar en un equipo". Vacío = el mismo origen del panel (cuando el panel se sirve detrás de la API).
VITE_ROBOT_SERVER_URL=
